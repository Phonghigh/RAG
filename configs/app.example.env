# App settings
APP_NAME=RCA-RAG
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rca_rag
DATABASE_ECHO=false

# Message Queue (redis, kafka, rabbitmq)
MQ_TYPE=redis
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_PREFIX=rca-rag
RABBITMQ_URL=amqp://admin:admin@localhost:5672/

# Storage (s3, minio)
STORAGE_TYPE=minio
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=rca-rag
S3_REGION=us-east-1
S3_USE_SSL=false

# Google Chat
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR_SPACE_ID/messages?key=YOUR_KEY&token=YOUR_TOKEN
GOOGLE_CHAT_THREAD_KEY=
GOOGLE_CHAT_NOTIFIED_USERS=user1@example.com,user2@example.com

# GitHub
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
GITHUB_TRUSTED_UA_PREFIX=GitHub-Hookshot/
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Retention
RETENTION_DAYS=90

# Observability
LOG_LEVEL=INFO
METRICS_ENABLED=true

# Security
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Air-gapped
ALLOW_EXTERNAL_REQUESTS=false
