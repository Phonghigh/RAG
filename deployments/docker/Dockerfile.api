FROM python:3.11-slim

WORKDIR /app

# System deps if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY requirements.txt /app/
# If using Poetry, install it; otherwise switch to requirements.txt flow
RUN pip install --no-cache-dir -r requirements.txt

COPY apps /app/apps
COPY configs /app/configs
COPY configs/.env /app/configs/app.env
COPY configs/logging.yaml /app/configs/logging.yaml

EXPOSE 8000
CMD ["uvicorn", "apps.gateway.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]